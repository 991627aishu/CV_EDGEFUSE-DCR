  "texture_suppression": {
    "gradient_ratio_thresh": 0.35,
    "edge_agreement_weight": 0.8
  },
  "model_checkpoint": "EDGEFUSE_DCR/models/edgefuse_dcr_compact.pth",
  "device": "cpu"
}

